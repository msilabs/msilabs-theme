{
  "name": "msilabs-theme",
  "displayName": "msilabs Theme",
  "description": "Eye-comfort dark and light themes: navy Dark, soft Light, paper Notebook and low blue light Warm Night.",
  "version": "0.1.2",
  "publisher": "msilabs",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/msilabs/msilabs-theme.git" },
  "bugs": { "url": "https://github.com/msilabs/msilabs-theme/issues" },
  "homepage": "https://github.com/msilabs/msilabs-theme#readme",
  "icon": "icon.png",
  "galleryBanner": { "color": "#14213D", "theme": "dark" },
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Themes"],
  "keywords": [
    "theme", "dark theme", "light theme", "dark", "light", "eye comfort", "low contrast", "soft",
    "minimal", "navy", "blue", "warm", "night", "paper", "notebook", "msilabs"
  ],
  "scripts": {
    "build": "node src/build.mjs",
    "dev": "node --watch src/build.mjs",
    "preview": "code --extensionDevelopmentPath=\"$PWD\" \"$PWD/samples\"",
    "screenshots": "zsh scripts/screenshots.sh"
  },
  "contributes": {
    "themes": [
      { "label": "msilabs Dark", "uiTheme": "vs-dark", "path": "./themes/msilabs-dark-color-theme.json" },
      { "label": "msilabs Light", "uiTheme": "vs", "path": "./themes/msilabs-light-color-theme.json" },
      { "label": "msilabs Notebook", "uiTheme": "vs", "path": "./themes/msilabs-notebook-color-theme.json" },
      { "label": "msilabs Warm Night", "uiTheme": "vs-dark", "path": "./themes/msilabs-warm-night-color-theme.json" }
    ]
  }
}
