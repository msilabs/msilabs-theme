<template>
    <section class="section container" id="preview">
        <div class="section-head">
            <p class="eyebrow">Live preview</p>
            <h2>See each theme on real code</h2>
            <p>Pick a theme. The colors below are the same ones the extension uses.</p>
        </div>

        <div class="tabs" role="group" aria-label="Theme">
            <button type="button" data-theme="dark" aria-pressed="true">Dark</button>
            <button type="button" data-theme="light" aria-pressed="false">Light</button>
            <button type="button" data-theme="notebook" aria-pressed="false">Notebook</button>
            <button type="button" data-theme="warm-night" aria-pressed="false">Warm Night</button>
        </div>

        <div class="editor editor-dark">
            <div class="titlebar">
                <span class="dot"></span><span class="dot"></span><span class="dot"></span>
                <span class="file">Card.alo</span>
            </div>
            <pre class="code"><code><span class="line"><span class="c-comment">&lt;!-- components/Card.alo: one file, one component --&gt;</span></span>
