<span class="line">    <span class="p">&lt;</span><span class="tag">article</span> <span class="a">class</span><span class="p">=</span><span class="s">"card"</span><span class="p">&gt;</span></span>
<span class="line">        <span class="p">&lt;</span><span class="tag">h3</span><span class="p">&gt;</span><span class="k">\{{</span> <span class="pr">props.title</span> <span class="k">}}</span><span class="p">&lt;/</span><span class="tag">h3</span><span class="p">&gt;</span></span>
<span class="line">        <span class="p">&lt;</span><span class="tag">template</span> <span class="k">for</span><span class="p">=</span><span class="s">"tag in props.tags"</span><span class="p">&gt;</span></span>
<span class="line">            <span class="p">&lt;</span><span class="tag">span</span> <span class="a">class</span><span class="p">=</span><span class="s">"tag"</span><span class="p">&gt;</span><span class="k">\{{</span> <span class="pr">tag</span> <span class="k">}}</span><span class="p">&lt;/</span><span class="tag">span</span><span class="p">&gt;</span></span>
<span class="line">        <span class="p">&lt;/</span><span class="tag">template</span><span class="p">&gt;</span></span>
<span class="line">        <span class="p">&lt;</span><span class="tag">slot</span><span class="p"> /&gt;</span></span>
<span class="line">    <span class="p">&lt;/</span><span class="tag">article</span><span class="p">&gt;</span></span>
<span class="line"><span class="p">&lt;/</span><span class="tag">template</span><span class="p">&gt;</span></span>
<span class="line"></span>
<span class="line"><span class="p">&lt;</span><span class="tag">style</span><span class="p">&gt;</span></span>
<span class="line">    <span class="t">.card</span> <span class="p">{</span> <span class="pr">padding</span><span class="p">:</span> <span class="n">1.5rem</span><span class="p">;</span> <span class="p">}</span></span>
<span class="line"><span class="p">&lt;/</span><span class="tag">style</span><span class="p">&gt;</span><span class="cursor"></span></span></code></pre>
            <div class="statusbar">
                <span class="left">
                    <span class="remote">&gt;&lt;</span>
                    <span>main</span>
                </span>
                <span>Alo</span>
            </div>
        </div>
    </section>
</template>

<style>
    .tabs {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
    }

    .tabs button {
        padding: 0.45rem 1.1rem;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: var(--surface);
        color: var(--muted);
        font: inherit;
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
    }

    .tabs button[aria-pressed='true'] {
        border-color: transparent;
        background: var(--accent);
        color: var(--on-accent);
    }

    .editor {
        overflow: hidden;
        max-width: 46rem;
        margin-inline: auto;
        border: 1px solid var(--ed-border);
        border-radius: var(--radius);
        background: var(--ed-bg);
        box-shadow: 0 20px 50px var(--ed-shadow);
        color: var(--ed-fg);
        font-family: var(--font-mono);
        transition: background 0.2s ease, color 0.2s ease;
    }

    .titlebar {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.7rem 1rem;
        background: var(--ed-chrome);
        border-bottom: 1px solid var(--ed-border);
    }

    .dot {
        width: 0.7rem;
        height: 0.7rem;
        border-radius: 50%;
        background: var(--ed-border);
    }

    .file {
        margin-inline-start: 0.75rem;
        padding: 0.15rem 0.7rem;
        border-top: 2px solid var(--ed-accent);
        color: var(--ed-fg);
        font-size: 0.85rem;
    }

    .code {
        margin: 0;
        padding: 1rem 0;
        overflow-x: auto;
        font-size: 0.9rem;
        line-height: 1.7;
        white-space: normal;
        counter-reset: line;
    }

    .code code {
        padding: 0;
        background: none;
        font-size: inherit;
    }

    .line {
        display: block;
        min-height: 1.7em;
        padding-inline: 1rem 1.5rem;
        white-space: pre;
        counter-increment: line;
    }

    .line::before {
        content: counter(line);
        display: inline-block;
        width: 2rem;
        margin-inline-end: 1.2rem;
        color: var(--ed-line);
        text-align: right;
    }

    .c-comment {
        color: var(--c-comment);
        font-style: italic;
    }

    .k { color: var(--c-keyword); }
    .f { color: var(--c-function); }
    .s { color: var(--c-string); }
    .n { color: var(--c-number); }
    .t { color: var(--c-type); }
    .p { color: var(--c-punctuation); }
    .pr { color: var(--c-property); }
    .tag { color: var(--c-tag); }
    .a { color: var(--c-attribute); }

    .cursor {
        display: inline-block;
        width: 2px;
        height: 1.15em;
        margin-inline-start: 1px;
        background: var(--ed-cursor);
        vertical-align: text-bottom;
        animation: blink 1.1s steps(1) infinite;
    }

    @keyframes blink {
        50% {
            opacity: 0;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .cursor {
            animation: none;
        }
    }

    .statusbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-inline-end: 1rem;
        border-top: 1px solid var(--ed-border);
        background: var(--ed-chrome);
        color: var(--ed-muted);
        font-size: 0.8rem;
    }

    .left {
        display: flex;
        align-items: center;
        gap: 0.9rem;
    }

    .remote {
        padding: 0.35rem 0.8rem;
        background: var(--ed-accent);
        color: var(--ed-on-accent);
        font-weight: 700;
    }
</style>

<script>
    const editor = $el.querySelector('.editor');
    const buttons = $el.querySelectorAll('.tabs button');

    buttons.forEach((button) => {
        button.addEventListener('click', () => {
            editor.className = 'editor editor-' + button.dataset.theme;
            buttons.forEach((other) => {
                other.setAttribute('aria-pressed', String(other === button));
            });
        });
    });
</script>
