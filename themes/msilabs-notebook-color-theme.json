  "tokenColors": [
    {
      "scope": [
        "variable",
        "variable.other.readwrite",
        "variable.parameter",
        "meta.definition.variable",
        "meta.template.expression",
        "meta.embedded.expression",
        "punctuation.definition.variable.php"
      ],
      "settings": {
        "foreground": "#1F2A44"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#6E6A61",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "punctuation",
        "keyword.operator",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#5A564E"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.word",
        "keyword.operator.logical.python",
        "variable.language",
        "variable.parameter.function.language.special.self.python",
        "support.function.construct",
        "keyword.blade",
        "punctuation.section.embedded",
        "punctuation.definition.template-expression",
        "keyword.control.alo",
        "meta.attribute.logic.alo",
        "punctuation.definition.list.begin.markdown",
        "meta.diff.header",
        "meta.diff.range"
      ],
      "settings": {
        "foreground": "#2F4BB0"
      }
    },
    {
      "scope": [
        "string",
        "string.template",
        "punctuation.definition.string",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#8A4B14"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "support.constant",
        "keyword.other.unit",
        "variable.other.enummember",
        "support.constant.property-value.css",
        "variable.other.normal.shell",
        "variable.other.special.shell",
        "variable.other.positional.shell"
      ],
      "settings": {
        "foreground": "#B3261E"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "meta.function-call.generic",
        "entity.name.command.shell",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#1F6E43"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.class",
        "support.type",
        "support.type.primitive",
        "storage.type.primitive",
        "keyword.other.type.php",
        "support.other.namespace.php",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#6B3FA0"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#B3261E"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#1F6E43"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#6B3FA0"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.placeholder",
        "punctuation.decorator",
        "punctuation.definition.decorator",
        "entity.name.function.decorator",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#9A5200"
      }
    },
    {
      "scope": [
        "punctuation.section.embedded.begin.alo",
        "punctuation.section.embedded.end.alo"
      ],
      "settings": {
        "foreground": "#2F4BB0"
      }
    },
    {
      "scope": [
        "markup.heading",
        "markup.heading entity.name",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#1F6E43",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#141B2E",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#1F2A44",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "foreground": "#5A564E",
        "fontStyle": "strikethrough"
      }
    },
    {
      "scope": [
        "string.other.link",
        "markup.link"
      ],
      "settings": {
        "foreground": "#6B3FA0"
      }
    },
    {
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#6B3FA0",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#6E6A61"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#1F6E43"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#B3261E"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#2F4BB0"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#B3261E"
      }
    },
    {
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#9A5200",
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticTokenColors": {
    "class": "#6B3FA0",
    "interface": "#6B3FA0",
    "enum": "#6B3FA0",
    "struct": "#6B3FA0",
    "type": "#6B3FA0",
    "typeParameter": "#6B3FA0",
    "namespace": "#6B3FA0",
    "enumMember": "#B3261E",
    "function": "#1F6E43",
    "method": "#1F6E43",
    "decorator": "#9A5200",
    "macro": "#9A5200",
    "property.declaration": "#6B3FA0",
    "variable.defaultLibrary": "#6B3FA0",
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
