  "tokenColors": [
    {
      "scope": [
        "variable",
        "variable.other.readwrite",
        "variable.parameter",
        "meta.definition.variable",
        "meta.template.expression",
        "meta.embedded.expression",
        "punctuation.definition.variable.php"
      ],
      "settings": {
        "foreground": "#CEC3B2"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#8C8274",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "punctuation",
        "keyword.operator",
        "meta.brace",
        "meta.delimiter",
        "begin.bracket",
        "end.bracket"
      ],
      "settings": {
        "foreground": "#A89D8C"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.word",
        "keyword.operator.logical.python",
        "variable.language",
        "variable.parameter.function.language.special.self.python",
        "support.variable.magic.python",
        "support.function.construct",
        "keyword.blade",
        "punctuation.section.embedded",
        "punctuation.definition.template-expression",
        "keyword.control.alo",
        "meta.attribute.logic.alo",
        "punctuation.definition.list.begin.markdown",
        "meta.diff.header",
        "meta.diff.range"
      ],
      "settings": {
        "foreground": "#D99AA5"
      }
    },
    {
      "scope": [
        "string",
        "string.template",
        "punctuation.definition.string",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#DDAE5E"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "support.constant",
        "keyword.other.unit",
        "variable.other.enummember",
        "support.constant.property-value.css",
        "variable.other.normal.shell",
        "variable.other.special.shell",
        "variable.other.positional.shell",
        "variable.parameter.positional.shell"
      ],
      "settings": {
        "foreground": "#E8937A"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "meta.function-call.generic",
        "entity.name.command.shell",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#93C4A6"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.class",
        "support.type",
        "support.type.primitive",
        "storage.type.primitive",
        "keyword.other.type.php",
        "support.other.namespace.php",
        "support.class.component",
        "fenced_code.block.language"
      ],
      "settings": {
        "foreground": "#8FBCC0"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#E8937A"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#93C4A6"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key",
        "entity.name.tag.yaml",
        "variable.css",
        "variable.argument.css"
      ],
      "settings": {
        "foreground": "#8FBCC0"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.placeholder",
        "constant.character.format.placeholder",
        "punctuation.decorator",
        "punctuation.definition.decorator",
        "entity.name.function.decorator",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#E8A33A"
      }
    },
    {
      "scope": [
        "punctuation.section.embedded.begin.alo",
        "punctuation.section.embedded.end.alo"
      ],
      "settings": {
        "foreground": "#FFB020"
      }
    },
    {
      "scope": [
        "markup.heading",
        "markup.heading entity.name",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#93C4A6",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#E2D8C6",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#CEC3B2",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "foreground": "#A89D8C",
        "fontStyle": "strikethrough"
      }
    },
    {
      "scope": [
        "string.other.link",
        "markup.link"
      ],
      "settings": {
        "foreground": "#8FBCC0"
      }
    },
    {
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#8FBCC0",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#8C8274"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#93C4A6"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#E8806E"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#8FBCC0"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#E8806E"
      }
    },
    {
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#DDAE5E",
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticTokenColors": {
    "class": "#8FBCC0",
    "interface": "#8FBCC0",
    "enum": "#8FBCC0",
    "struct": "#8FBCC0",
    "type": "#8FBCC0",
    "typeParameter": "#8FBCC0",
    "namespace": "#8FBCC0",
    "enumMember": "#E8937A",
    "function": "#93C4A6",
    "method": "#93C4A6",
    "decorator": "#E8A33A",
    "macro": "#E8A33A",
    "property.declaration": "#8FBCC0",
    "variable.defaultLibrary": "#8FBCC0",
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
