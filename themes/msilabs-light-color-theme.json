  "tokenColors": [
    {
      "scope": [
        "variable",
        "variable.other.readwrite",
        "variable.parameter",
        "meta.definition.variable",
        "meta.template.expression",
        "meta.embedded.expression",
        "punctuation.definition.variable.php"
      ],
      "settings": {
        "foreground": "#26354F"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#5B6782",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "punctuation",
        "keyword.operator",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#4A5A75"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.word",
        "keyword.operator.logical.python",
        "variable.language",
        "variable.parameter.function.language.special.self.python",
        "support.function.construct",
        "keyword.blade",
        "punctuation.section.embedded",
        "punctuation.definition.template-expression",
        "keyword.control.alo",
        "meta.attribute.logic.alo",
        "punctuation.definition.list.begin.markdown",
        "meta.diff.header",
        "meta.diff.range"
      ],
      "settings": {
        "foreground": "#6D3FD0"
      }
    },
    {
      "scope": [
        "string",
        "string.template",
        "punctuation.definition.string",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#8A5A00"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "support.constant",
        "keyword.other.unit",
        "variable.other.enummember",
        "support.constant.property-value.css",
        "variable.other.normal.shell",
        "variable.other.special.shell",
        "variable.other.positional.shell"
      ],
      "settings": {
        "foreground": "#B8391F"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "meta.function-call.generic",
        "entity.name.command.shell",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#0A7363"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.class",
        "support.type",
        "support.type.primitive",
        "storage.type.primitive",
        "keyword.other.type.php",
        "support.other.namespace.php",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#1F5FBF"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#B8391F"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#0A7363"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#1F5FBF"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.placeholder",
        "punctuation.decorator",
        "punctuation.definition.decorator",
        "entity.name.function.decorator",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#A44A06"
      }
    },
    {
      "scope": [
        "punctuation.section.embedded.begin.alo",
        "punctuation.section.embedded.end.alo"
      ],
      "settings": {
        "foreground": "#0B7F6E"
      }
    },
    {
      "scope": [
        "markup.heading",
        "markup.heading entity.name",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#0A7363",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#14213D",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#26354F",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "foreground": "#4A5A75",
        "fontStyle": "strikethrough"
      }
    },
    {
      "scope": [
        "string.other.link",
        "markup.link"
      ],
      "settings": {
        "foreground": "#1F5FBF"
      }
    },
    {
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#1F5FBF",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#5B6782"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#0A7363"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#C2372A"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#1F5FBF"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#C2372A"
      }
    },
    {
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#A44A06",
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticTokenColors": {
    "class": "#1F5FBF",
    "interface": "#1F5FBF",
    "enum": "#1F5FBF",
    "struct": "#1F5FBF",
    "type": "#1F5FBF",
    "typeParameter": "#1F5FBF",
    "namespace": "#1F5FBF",
    "enumMember": "#B8391F",
    "function": "#0A7363",
    "method": "#0A7363",
    "decorator": "#A44A06",
    "macro": "#A44A06",
    "property.declaration": "#1F5FBF",
    "variable.defaultLibrary": "#1F5FBF",
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
