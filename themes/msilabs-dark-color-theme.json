  "tokenColors": [
    {
      "scope": [
        "variable",
        "variable.other.readwrite",
        "variable.parameter",
        "meta.definition.variable",
        "meta.template.expression",
        "meta.embedded.expression",
        "punctuation.definition.variable.php"
      ],
      "settings": {
        "foreground": "#D3DCEA"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#7F8DAA",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "punctuation",
        "keyword.operator",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#8E9CBA"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.word",
        "keyword.operator.logical.python",
        "variable.language",
        "variable.parameter.function.language.special.self.python",
        "support.function.construct",
        "keyword.blade",
        "punctuation.section.embedded",
        "punctuation.definition.template-expression",
        "keyword.control.alo",
        "meta.attribute.logic.alo",
        "punctuation.definition.list.begin.markdown",
        "meta.diff.header",
        "meta.diff.range"
      ],
      "settings": {
        "foreground": "#B4A5FF"
      }
    },
    {
      "scope": [
        "string",
        "string.template",
        "punctuation.definition.string",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#EBC57F"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "support.constant",
        "keyword.other.unit",
        "variable.other.enummember",
        "support.constant.property-value.css",
        "variable.other.normal.shell",
        "variable.other.special.shell",
        "variable.other.positional.shell"
      ],
      "settings": {
        "foreground": "#FF9E85"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "meta.function-call.generic",
        "entity.name.command.shell",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#4FD8BF"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.class",
        "support.type",
        "support.type.primitive",
        "storage.type.primitive",
        "keyword.other.type.php",
        "support.other.namespace.php",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#82C3FF"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#FF9E85"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#4FD8BF"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#82C3FF"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.placeholder",
        "punctuation.decorator",
        "punctuation.definition.decorator",
        "entity.name.function.decorator",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#FFB020"
      }
    },
    {
      "scope": [
        "punctuation.section.embedded.begin.alo",
        "punctuation.section.embedded.end.alo"
      ],
      "settings": {
        "foreground": "#1ED6A8"
      }
    },
    {
      "scope": [
        "markup.heading",
        "markup.heading entity.name",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#4FD8BF",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#E9EEF8",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#D3DCEA",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "foreground": "#97A3BD",
        "fontStyle": "strikethrough"
      }
    },
    {
      "scope": [
        "string.other.link",
        "markup.link"
      ],
      "settings": {
        "foreground": "#82C3FF"
      }
    },
    {
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#82C3FF",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#7F8DAA"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#1ED6A8"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#FF7B6B"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#82C3FF"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FF7B6B"
      }
    },
    {
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#FFB020",
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticTokenColors": {
    "class": "#82C3FF",
    "interface": "#82C3FF",
    "enum": "#82C3FF",
    "struct": "#82C3FF",
    "type": "#82C3FF",
    "typeParameter": "#82C3FF",
    "namespace": "#82C3FF",
    "enumMember": "#FF9E85",
    "function": "#4FD8BF",
    "method": "#4FD8BF",
    "decorator": "#FFB020",
    "macro": "#FFB020",
    "property.declaration": "#82C3FF",
    "variable.defaultLibrary": "#82C3FF",
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
